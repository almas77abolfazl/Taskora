{
  "name": "todo-list-with-electronjs",
  "version": "2.0.0",
  "packageManager": "pnpm@11.21.0",
  "description": "A modern, bilingual, offline-first task management desktop application built with Electron, React 19, TypeScript, and Clean Architecture.",
  "main": "./out/main/index.js",
  "author": "Abolfazl Nasiri Almas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almas77abolfazl/todo-list-with-electronJS.git"
  },
  "bugs": {
    "url": "https://github.com/almas77abolfazl/todo-list-with-electronJS/issues"
  },
  "homepage": "https://github.com/almas77abolfazl/todo-list-with-electronJS#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
